#!/usr/bin/env bash
# omabox stand-in for systemd-cat, first on the box's PATH (finding 131): a box has no journald, so
# the real one fails, and `omarchy restart shell` (omarchy-launch-shell runs the bar under
# `systemd-cat -t omarchy-shell`) left the box with no bar. Here the output goes to ~/IDENTIFIER.log
# (~/systemd-cat.log without -t). The shell's goes to ~/shell.log, and its pid to the file omabox's
# own restart-shell reads (exec keeps it), so either restart stops the other's shell.
tag=""
while [ $# -gt 0 ]; do
  case $1 in
    --) shift; break ;;
    -t|--identifier) tag=$2; shift ;;
    -p|--priority|--stderr-priority|--namespace|--level-prefix) shift ;;
    --identifier=*) tag=${1#*=} ;;
    -h|--help) echo "systemd-cat (omabox stand-in): output to ~/IDENTIFIER.log; systemd-cat [-t ID] [--] [CMD [ARG...]]"; exit 0 ;;
    -*) ;;
    *) break ;;
  esac
  shift
done
log=$HOME/${tag:-systemd-cat}.log
if [ "$tag" = omarchy-shell ]; then
  log=$HOME/shell.log
  [ $# = 0 ] || echo $$ > "$XDG_RUNTIME_DIR/omabox-shell.pid"
  # The box's own quickshell (#151: the launcher runs the bar in every box now), not a stub of a test's
  # in the box HOME's ~/.local/bin, which comes before /usr/bin; the shell's PATH stays the session's.
  # `up --quickshell`'s build when share/session.sh linked one (finding 358). With --log-times (#276):
  # each line its time to the millisecond, as the journal gives it on a desktop (`omabox log shell`);
  # it changes the log's lines only.
  if [ "${1:-}" = quickshell ]; then
    qs=$XDG_RUNTIME_DIR/omabox-quickshell/quickshell
    [ -x "$qs" ] || qs=/usr/bin/quickshell
    set -- "$qs" --log-times "${@:2}"
  fi
fi
[ $# -gt 0 ] || exec cat >> "$log"
exec "$@" >> "$log" 2>&1
